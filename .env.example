NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student-learning-portal

# Student auth (never reuse for admin)
JWT_SECRET=change-this-to-a-long-random-student-secret
JWT_EXPIRES_IN=7d

# Admin auth — MUST be different from JWT_SECRET
JWT_ADMIN_SECRET=change-this-to-a-different-long-random-admin-secret

# Frontend origin(s) allowed by CORS. Comma-separated for multiple deploys.
CLIENT_URL=http://localhost:5173

SITE_NAME=PRADEEP'S EDUCATIONAL ACADEMY
COOKIE_SECURE=false

# Optional defaults for npm run seed:admin
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Portal Admin

# Object storage: supabase (default, free) | r2 (later, when you have billing)
STORAGE_PROVIDER=supabase

# Supabase Storage — Project Settings → API
# Use the service_role key on the server only (never in the frontend).
# Create a public bucket named "worksheets" in Storage.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=worksheets

# Cloudflare R2 — optional later. Set STORAGE_PROVIDER=r2 when ready.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=worksheets
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
